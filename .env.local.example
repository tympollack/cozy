# ---------------------------------------------------------------
# Cozy PWA — Environment Variables
# Copy this file to .env.local (gitignored) and fill in values.
# NEXT_PUBLIC_ vars are safe to expose to the browser.
# All others are server-only — NEVER prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------

# ----------------------------------------------------------
# Supabase — shared ecosystem project, dedicated cozy schema
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role — SERVER ONLY. Rotate immediately if committed.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ----------------------------------------------------------
# Cloudflare R2 — image storage
# ----------------------------------------------------------
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=cozy-images

# Public R2 hostname (without https://), e.g. pub-abc123.r2.dev
NEXT_PUBLIC_R2_PUBLIC_HOSTNAME=pub-<token>.r2.dev

# Full public base URL for constructing image URLs
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-<token>.r2.dev
